<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <!-- TODO: Adjust backup rules here. See https://developer.android.com/guide/topics/data/autobackup -->
        <exclude domain="database" path="pet_manager_db.db" />
        <exclude domain="sharedpref" path="pet_manager_prefs.xml"/>
        <exclude domain="file" path="."/>
        <exclude domain="root" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="pet_manager_db.db" />
        <include domain="sharedpref" path="pet_manager_prefs.xml"/>
        <!-- <include .../> -->
    </device-transfer>
</data-extraction-rules>
